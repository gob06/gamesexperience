# Server port (AI Studio uses 3000)
PORT=3000

# Database configuration
# Defaults to local SQLite when DATABASE_URL and DB_NAME/DB_USER are not set
DB_DRIVER=sqlite
SQLITE_PATH=data/roomvote-local.sqlite

# Optional MariaDB / MySQL configuration
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/vote
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_CONNECTION_LIMIT=10

# Storage and proxy configuration
DATA_DIR=data
TRUST_PROXY_HOPS=0

# Limits and session durations
VOTING_SESSION_DURATION_SECONDS=604800
AD_VIDEO_MAX_BYTES=209715200
THEME_IMAGE_MAX_BYTES=52428800
QA_RATE_LIMIT_PER_MINUTE=3000
RAFFLE_REGISTRATION_LIMIT_PER_MINUTE=60
SCRAMBLE_REGISTRATION_LIMIT_PER_MINUTE=60
SCRAMBLE_ANSWER_LIMIT_PER_MINUTE=60
